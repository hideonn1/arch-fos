[Unit]
Description=Arch Forward Observations System - Collector
Documentation=https://github.com/hideon/arch-fos
After=local-fs.target network-online.target dbus.service
Wants=local-fs.target network-online.target

[Service]
Type=simple
User=arch-fos-collector
Group=arch-fos-collector
StateDirectory=arch-fos
StateDirectoryMode=0750
RuntimeDirectory=arch-fos
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/arch-fos-collector --db-path /var/lib/arch-fos/arch-fos.db --control-socket /run/arch-fos/collector.sock --rules-dir /etc/arch-fos/rules
# Optional: use `systemctl edit arch-fos-collector.service` with Environment=ARCH_FOS_ABUSECH_AUTH_KEY=<key> to enable URLhaus v2 export
Restart=on-failure
RestartSec=5s

# US-03: Minimal privileges (collector is sole DB writer & eBPF/netlink owner)
AmbientCapabilities=CAP_BPF CAP_NET_RAW CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_NET_RAW CAP_PERFMON
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/arch-fos
ReadOnlyPaths=/var/lib/pacman /etc/arch-fos/rules

# Hardening for systemd-analyze security <= 3.0 while preserving /proc, eBPF, D-Bus & feeds
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @reboot @swap @raw-io @cpu-emulation
SystemCallFilter=bpf perf_event_open
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
