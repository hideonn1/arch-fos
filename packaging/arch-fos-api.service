[Unit]
Description=Arch Forward Observations System - Unprivileged API & Dashboard
Documentation=https://github.com/hideon/arch-fos
After=network.target arch-fos-collector.service
Wants=arch-fos-collector.service

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=arch-fos-collector
RuntimeDirectory=arch-fos-api
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/arch-fos-api --db-path /var/lib/arch-fos/arch-fos.db --listen 127.0.0.1:8420 --token-file /run/arch-fos-api/api.token --collector-socket /run/arch-fos/collector.sock
Restart=on-failure
RestartSec=5s

# US-03: Zero privileges / zero capabilities
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/arch-fos

# Hardening for systemd-analyze security <= 3.0
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @reboot @swap @raw-io @cpu-emulation
UMask=0077

[Install]
WantedBy=multi-user.target
